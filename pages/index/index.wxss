.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background-color: #ffffff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  height: 80rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background-color: transparent;
}

.clear-icon {
  font-size: 28rpx;
  color: #cccccc;
  padding: 10rpx;
  flex-shrink: 0;
}

/* Tabs */
.tabs {
  display: flex;
  background-color: #ffffff;
  padding: 0 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #07c160;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #07c160;
  border-radius: 3rpx;
}

/* 分类栏 */
.category-bar {
  background-color: #ffffff;
  white-space: nowrap;
  padding: 16rpx 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.category-pill {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #666666;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.category-pill.active {
  background-color: #e8f5e9;
  color: #07c160;
  font-weight: 500;
}

/* 列表容器 */
.list-container {
  flex: 1;
  height: calc(100vh - 360rpx);
}

/* 结果计数 */
.result-count {
  font-size: 24rpx;
  color: #999999;
  padding: 16rpx 24rpx 0;
}

/* 卡片 */
.item-list {
  padding: 16rpx 20rpx;
}

.item-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s;
}

.item-card:active {
  transform: scale(0.98);
}

.image-wrap {
  position: relative;
  flex-shrink: 0;
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}

.item-image-placeholder {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-icon {
  font-size: 60rpx;
}

.image-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.item-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-header {
  display: flex;
  align-items: flex-start;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-tags-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.tag-lost {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.tag-found {
  background-color: #f6ffed;
  color: #52c41a;
}

.tag-category {
  background-color: #f0f0f0;
  color: #999999;
}

.item-info {
  margin-top: 12rpx;
}

.item-location {
  font-size: 24rpx;
  color: #666666;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.item-time {
  font-size: 22rpx;
  color: #cccccc;
}

/* 骨架屏 */
.skeleton-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 20rpx 16rpx;
}

.skeleton-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  flex-shrink: 0;
}

.skeleton-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-title {
  width: 80%;
  height: 32rpx;
}

.skeleton-info {
  width: 60%;
}

.skeleton-time {
  width: 40%;
  height: 22rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background-color: #07c160;
  color: #ffffff;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.empty-btn:active {
  opacity: 0.8;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
}

/* FAB */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
}

.fab-btn:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
}

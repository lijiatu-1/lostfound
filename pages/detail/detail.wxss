.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.scroll-container {
  height: calc(100vh - 120rpx);
}

.detail-swiper {
  width: 100%;
  height: 480rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.detail-image-placeholder {
  width: 100%;
  height: 480rpx;
  background-color: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 80rpx;
}

.detail-content {
  background-color: #ffffff;
  margin-top: -40rpx;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  position: relative;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-btn {
  font-size: 24rpx;
  color: #07c160;
  padding: 4rpx 16rpx;
  border: 2rpx solid #07c160;
  border-radius: 8rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-lost {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.tag-found {
  background-color: #f6ffed;
  color: #52c41a;
}

.detail-time {
  font-size: 26rpx;
  color: #999999;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

.detail-info {
  display: flex;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.info-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.info-text {
  font-size: 28rpx;
  color: #666666;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.item-tag {
  background-color: #f0f0f0;
  color: #666666;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.detail-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  display: block;
}

/* 评论区 */
.comments-section {
  padding-bottom: 40rpx;
}

.comment-input-wrap {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  min-height: 80rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.comment-submit {
  width: 120rpx;
  height: 80rpx;
  background-color: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.comment-list {
  padding-left: 10rpx;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-user {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

.comment-time {
  font-size: 22rpx;
  color: #999999;
}

.comment-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
}

.comment-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999999;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn-secondary {
  background-color: #f5f5f5;
  color: #666666;
  margin-right: 20rpx;
}

.action-btn-primary {
  background-color: #07c160;
  color: #ffffff;
}

.action-btn-auth {
  background-color: #f5f5f5;
  color: #999999;
  font-size: 26rpx;
}

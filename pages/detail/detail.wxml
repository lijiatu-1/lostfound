<view class="container">
  <view wx:if="{{isLoading}}" class="loading-wrap"><text>加载中...</text></view>
  <view wx:elif="{{error}}" class="loading-wrap">
    <text>{{error}}</text>
    <button bindtap="retry">重试</button>
  </view>
  <block wx:elif="{{item}}">
    <scroll-view scroll-y class="scroll-container">
      <swiper wx:if="{{item.imageList.length}}" class="detail-swiper" indicator-dots="{{item.imageList.length > 1}}">
        <swiper-item wx:for="{{item.imageList}}" wx:key="*this">
          <image class="swiper-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}" />
        </swiper-item>
      </swiper>
      <view wx:else class="detail-image-placeholder"><text>{{item.type === 'lost' ? '🔍' : '✅'}}</text></view>
      <view class="detail-content">
        <view class="detail-header">
          <text class="tag {{item.type === 'lost' ? 'tag-lost' : 'tag-found'}}">{{item.type === 'lost' ? '寻物' : '招领'}}</text>
          <text wx:if="{{isOwner && item.status === 'active'}}" class="edit-btn" bindtap="goEdit">编辑</text>
          <text class="detail-time">{{item.timeAgo}}</text>
        </view>
        <text class="detail-title">{{item.title}}</text>
        <view class="detail-info">
          <view class="info-item"><text>📍 {{item.locationName}}</text></view>
          <view class="info-item" wx:if="{{item.status === 'processing'}}"><text>处理中</text></view>
          <view class="info-item" wx:if="{{item.status === 'resolved'}}"><text>已解决</text></view>
          <view class="info-item" wx:if="{{item.status === 'expired'}}"><text>已过期</text></view>
        </view>
        <view class="tag-row" wx:if="{{item.tagList.length}}">
          <text class="item-tag" wx:for="{{item.tagList}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="detail-section">
          <text class="section-title">详细描述</text>
          <text class="detail-desc">{{item.description}}</text>
        </view>
        <view class="detail-section comments-section" wx:if="{{item.type === 'lost'}}">
          <text class="section-title">公开评论 ({{comments.length}})</text>
          <view wx:if="{{commentError}}" class="comment-empty">
            <text>{{commentError}}</text>
            <button size="mini" bindtap="retryComments">重试</button>
          </view>
          <view class="comment-input-wrap" wx:if="{{item.status === 'active' && !isOwner && isAuthenticated}}">
            <textarea class="comment-input" placeholder="公开评论，请勿填写敏感信息" value="{{commentContent}}" bindinput="onCommentInput" maxlength="500" />
            <view class="comment-submit" bindtap="submitComment">发表</view>
          </view>
          <view class="comment-list" wx:if="{{!commentError && comments.length}}">
            <view class="comment-item" wx:for="{{comments}}" wx:key="id">
              <view class="comment-header"><text>{{item.nickname}}</text><text>{{item.timeAgo}}</text></view>
              <text class="comment-content">{{item.content}}</text>
            </view>
          </view>
          <view wx:elif="{{!commentError}}" class="comment-empty">暂无评论</view>
        </view>
      </view>
    </scroll-view>
    <view class="action-bar" wx:if="{{!isOwner && item.status === 'active'}}">
      <view class="action-btn action-btn-primary" bindtap="apply">{{item.type === 'found' ? '申请认领' : '提供线索'}}</view>
    </view>
    <view class="action-bar" wx:if="{{isOwner && item.status === 'active'}}">
      <view class="action-btn action-btn-secondary" bindtap="goApplications">查看申请</view>
      <view class="action-btn action-btn-primary" bindtap="markResolved">结案</view>
      <view class="action-btn action-btn-secondary" wx:if="{{canRenew}}" bindtap="renewItem">延期</view>
    </view>
    <view class="action-bar" wx:if="{{isOwner && item.status === 'processing'}}">
      <view class="action-btn action-btn-secondary" bindtap="goApplications">查看申请</view>
      <view class="action-btn action-btn-secondary" bindtap="reopenItem">重新开放</view>
      <view class="action-btn action-btn-primary" bindtap="markResolved">结案</view>
    </view>
    <view class="action-bar" wx:if="{{isOwner && item.status === 'expired'}}">
      <view class="action-btn action-btn-primary" bindtap="renewItem">延期</view>
    </view>
  </block>
</view>

<view class="container">
  <view class="msg-header">
    <text class="msg-title">消息中心</text>
    <text class="msg-mark-all" bindtap="markAllRead">全部已读</text>
  </view>

  <view wx:if="{{isLoading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <scroll-view wx:else scroll-y class="msg-list">
    <view class="msg-item" wx:for="{{messages}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}" data-item-id="{{item.relatedItemId}}">
      <view class="msg-content">
        <view class="msg-top">
          <text class="msg-name">{{item.title}}</text>
          <text class="msg-time">{{item.timeAgo}}</text>
        </view>
        <text class="msg-text">{{item.content}}</text>
      </view>
      <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
    </view>

    <view class="empty-state" wx:if="{{messages.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无消息</text>
    </view>
  </scroll-view>
</view>

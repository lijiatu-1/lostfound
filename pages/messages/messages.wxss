.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.msg-header {
  background-color: #ffffff;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.msg-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.msg-mark-all {
  font-size: 26rpx;
  color: #07c160;
  padding: 8rpx 16rpx;
}

.msg-list {
  height: calc(100vh - 100rpx);
  padding: 20rpx 30rpx;
}

.msg-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.msg-content {
  flex: 1;
  overflow: hidden;
}

.msg-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.msg-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.msg-time {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.msg-text {
  font-size: 26rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.msg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ff4d4f;
  margin-left: 16rpx;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.page-header {
  background-color: #ffffff;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.claim-list {
  height: calc(100vh - 100rpx);
  padding: 20rpx 30rpx;
}

.claim-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 300rpx;
}

.card-content {
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.tag-help {
  background-color: #e6f7ff;
  color: #1890ff;
}

.tag-claim {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-tag {
  font-size: 24rpx;
  font-weight: 500;
}

.status-pending {
  color: #fa8c16;
}

.status-accepted {
  color: #52c41a;
}

.status-rejected {
  color: #ff4d4f;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

.card-info {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
  display: block;
}

.card-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: block;
}

.card-footer {
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}

.contact-name {
  font-size: 26rpx;
  color: #666666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
.page { padding: 32rpx; background: #f5f7f6; min-height: 100vh; box-sizing: border-box; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 30rpx; }
.state { text-align: center; color: #777; padding: 80rpx 20rpx; }
.card { background: #fff; border-radius: 18rpx; padding: 28rpx; margin-bottom: 22rpx; }
.meta,.status { color: #777; font-size: 26rpx; }
.content { margin: 18rpx 0; white-space: pre-wrap; }
.actions { display: flex; justify-content: flex-end; gap: 16rpx; }

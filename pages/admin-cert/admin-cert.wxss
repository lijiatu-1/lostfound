.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.page-header {
  background-color: #ffffff;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.cert-list {
  height: calc(100vh - 100rpx);
  padding: 20rpx 30rpx;
}

.cert-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.cert-info {
  margin-bottom: 20rpx;
}

.cert-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.cert-row:last-child {
  border-bottom: none;
}

.cert-label {
  font-size: 26rpx;
  color: #999999;
  width: 140rpx;
  flex-shrink: 0;
}

.cert-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

.cert-actions {
  display: flex;
  gap: 20rpx;
}

.btn-approve {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-reject {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #ff4d4f;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

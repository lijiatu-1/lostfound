<view class="container">
  <view class="upload-section">
    <view class="upload-title">物品图片</view>
    <view class="image-grid">
      <view class="image-item" wx:for="{{imageAssets}}" wx:key="assetId">
        <image class="grid-image" src="{{item.url}}" mode="aspectFill" />
        <view class="image-delete" catchtap="deleteImage" data-index="{{index}}">✕</view>
      </view>
      <view class="image-add" wx:if="{{imageAssets.length < 9}}" bindtap="chooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">{{imageAssets.length}}/9</text>
      </view>
    </view>
    <text class="upload-hint">最多上传9张。图片会作为本条物品的受控资产保存。</text>
    <view class="ai-btn" wx:if="{{imageAssets.length > 0 && !imageUploading}}" bindtap="aiRecognize">
      <text class="ai-btn-text">{{aiLoading ? '识别中...' : 'AI 智能识别'}}</text>
    </view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="form-label">类型</text>
      <view class="type-selector {{editMode ? 'disabled' : ''}}" bindtap="switchType">
        <text class="type-text">{{type === 'lost' ? '寻物' : '招领'}}</text>
        <text class="type-arrow">{{editMode ? '编辑时不可更改' : '>'}}</text>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">分类</text>
      <scroll-view class="category-scroll" scroll-x enable-flex>
        <view class="cat-pill {{selectedCategory === item ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this" bindtap="selectCategory" data-category="{{item}}">{{item}}</view>
      </scroll-view>
    </view>
    <view class="form-item">
      <text class="form-label">标题</text>
      <input class="form-input" placeholder="请输入物品名称" value="{{formData.title}}" bindinput="onInput" data-field="title" />
    </view>
    <view class="form-item location-item">
      <text class="form-label">地点</text>
      <view class="field-stack">
        <input class="form-input" placeholder="如：北校区图书馆三楼" value="{{formData.location}}" bindinput="onInput" data-field="location" />
        <text class="field-hint">仅填写校区、楼栋或公共区域，不会上传精确坐标。</text>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" placeholder="请详细描述物品特征、丢失/捡到时间等信息" value="{{formData.description}}" bindinput="onInput" data-field="description" maxlength="500" />
    </view>
    <view class="form-item">
      <text class="form-label">标签</text>
      <view class="field-stack">
        <input class="form-input" placeholder="可用逗号分隔，如：黑色、耳机、图书馆" value="{{tagsInput}}" bindinput="onTagsInput" maxlength="100" />
        <text class="field-hint">不填写时会根据标题和描述自动生成标签。</text>
      </view>
    </view>
  </view>

  <view class="submit-btn" bindtap="submitForm">
    <text class="submit-text">{{editMode ? '保存修改' : '发布'}}</text>
  </view>
</view>

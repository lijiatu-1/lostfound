.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #07c160 0%, #f5f5f5 30%);
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.auth-header {
  padding: 100rpx 30rpx 60rpx;
  text-align: center;
}

.header-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 16rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.auth-content {
  background-color: #ffffff;
  margin: 0 30rpx;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #07c160;
}

.upload-area {
  width: 100%;
  height: 300rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.upload-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.tips-card {
  background-color: #fffbe6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #fa8c16;
  display: block;
  margin-bottom: 12rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #fa8c16;
  display: block;
  line-height: 1.8;
}

.auth-footer {
  padding: 40rpx 30rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background-color: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  background-color: #06ad56;
}

.footer-text {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  margin-top: 20rpx;
  display: block;
}
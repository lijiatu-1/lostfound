.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.page-header {
  background-color: #ffffff;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.filter-tabs {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.filter-tab {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  border-radius: 24rpx;
  margin-right: 20rpx;
}

.filter-tab.active {
  background-color: #07c160;
  color: #ffffff;
}

.publish-list {
  height: calc(100vh - 200rpx);
  padding: 20rpx 30rpx;
}

.publish-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-image {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.tag-lost {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.tag-found {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-tag {
  font-size: 22rpx;
  color: #999999;
}

.status-resolved {
  color: #52c41a;
}

.status-active {
  color: #07c160;
}

.action-item-renew {
  color: #1890ff;
}

.card-image-placeholder {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.card-info {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
  display: block;
}

.card-actions {
  display: flex;
  margin-top: auto;
}

.action-item {
  font-size: 24rpx;
  color: #07c160;
  margin-right: 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
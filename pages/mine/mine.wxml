<view class="container">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-avatar">
      <image wx:if="{{user.avatarUrl}}" src="{{user.avatarUrl}}" class="avatar-img" />
      <text wx:else class="avatar-text">👤</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{user.nickname || '未登录'}}</text>
      <view class="auth-status {{isAuthenticated ? 'authenticated' : 'unauthenticated'}}">
        {{isAuthenticated ? '✓ 已认证' : '未认证'}}
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-row">
    <view class="stat-item" bindtap="goToMyPublish">
      <text class="stat-value">{{myItems.length}}</text>
      <text class="stat-label">我的发布</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goToMessages">
      <text class="stat-value">{{unreadCount}}</text>
      <text class="stat-label">未读消息</text>
      <view class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{resolvedCount}}</text>
      <text class="stat-label">已解决</text>
    </view>
  </view>

  <!-- 认证与管理 -->
  <view class="menu-group">
    <text class="group-title">认证与管理</text>
    <view class="menu-list">
      <view class="menu-item" wx:if="{{!isAuthenticated}}" bindtap="goToAuth">
        <view class="menu-icon">🎓</view>
        <text class="menu-text">校园卡认证</text>
        <view class="menu-badge">去认证</view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goToAdminCert">
        <view class="menu-icon">📋</view>
        <text class="menu-text">审核认证</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToMyPublish">
        <view class="menu-icon">📦</view>
        <text class="menu-text">我的发布</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 账号与设置 -->
  <view class="menu-group">
    <text class="group-title">账号与设置</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="editProfile">
        <view class="menu-icon">✏️</view>
        <text class="menu-text">修改昵称</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="clearCache">
        <view class="menu-icon">🗑️</view>
        <text class="menu-text">清除缓存</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
